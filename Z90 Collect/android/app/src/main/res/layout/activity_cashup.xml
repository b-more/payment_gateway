<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="12dp" android:paddingEnd="16dp">
        <ImageView android:id="@+id/backBtn" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_back" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Shift cash-up" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="6dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:id="@+id/period" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/slate" android:textSize="12sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" android:padding="18dp" android:layout_marginTop="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TAKINGS THIS SHIFT" android:textColor="@color/slate" android:textSize="12sp" android:letterSpacing="0.06" />
                <TextView android:id="@+id/grandTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K0.00" android:textColor="@color/success" android:textSize="38sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/countLine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 sales" android:textColor="@color/slate" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BY ATTENDANT" android:textColor="@color/slate" android:textSize="12sp" android:letterSpacing="0.06" android:layout_marginTop="18dp" android:layout_marginBottom="6dp" />
            <LinearLayout android:id="@+id/attendantList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BY NETWORK" android:textColor="@color/slate" android:textSize="12sp" android:letterSpacing="0.06" android:layout_marginTop="18dp" android:layout_marginBottom="6dp" />
            <LinearLayout android:id="@+id/networkList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface" android:padding="16dp">
        <Button android:id="@+id/printBtn" android:layout_width="match_parent" android:layout_height="52dp" android:text="Print cash-up" android:textAllCaps="false" android:textSize="16sp" style="?attr/materialButtonOutlinedStyle" android:textColor="@color/brand" />
        <Button android:id="@+id/closeBtn" android:layout_width="match_parent" android:layout_height="56dp" android:text="Print &amp; close shift" android:textAllCaps="false" android:textSize="17sp" android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>

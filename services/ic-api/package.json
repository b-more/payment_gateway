{
  "name": "ic-api",
  "version": "0.1.0",
  "private": true,
  "description": "Instacompay payment gateway API (NestJS).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "ts-node src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "provision:roles": "ts-node src/db/provision-roles.ts",
    "provision:roles:prod": "node dist/db/provision-roles.js",
    "settlements:run": "node dist/jobs/run-settlements.js",
    "reconcile:run": "node dist/jobs/run-reconciliation.js",
    "test:unit": "node -r ts-node/register --test test/charges.spec.ts test/state-machine.spec.ts test/money.spec.ts test/webhook.spec.ts",
    "test:int": "node -r ts-node/register --test test/engine.itest.ts",
    "test:api": "node -r ts-node/register --test test/api.itest.ts",
    "test:webhook": "node -r ts-node/register --test test/webhook.itest.ts",
    "test:onboarding": "node -r ts-node/register --test test/onboarding.itest.ts",
    "test:settlement": "node -r ts-node/register --test test/settlement.itest.ts",
    "test:auth": "node -r ts-node/register --test test/auth.itest.ts",
    "test:merchant": "node -r ts-node/register --test test/merchant.itest.ts",
    "test:email": "node -r ts-node/register --test test/email.itest.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "hash-wasm": "^4.12.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/smtp-server": "^3.5.10",
    "smtp-server": "^3.13.6",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "jiti": "^2.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}

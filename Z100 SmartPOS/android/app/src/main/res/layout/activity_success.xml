<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg">

    <!-- Confirmation -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_success_ring">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_success_dot"
                android:padding="14dp"
                android:src="@drawable/ic_check"
                android:contentDescription="Success" />
        </FrameLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment received" android:textColor="@color/slate" android:textSize="15sp" android:layout_marginTop="18dp" />
        <TextView android:id="@+id/successAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K0.00" android:textColor="@color/ink" android:textSize="46sp" android:textStyle="bold" />
        <TextView android:id="@+id/successMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/ink" android:textSize="13sp" android:background="@drawable/bg_seg_on" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginTop="12dp" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="26dp">
            <Button android:id="@+id/printBtn" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Print receipt" android:textAllCaps="false" android:textSize="15sp" android:paddingStart="22dp" android:paddingEnd="22dp" />
            <Button android:id="@+id/newSaleBtn" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="New sale" android:textAllCaps="false" android:textSize="15sp" android:layout_marginStart="12dp" android:paddingStart="22dp" android:paddingEnd="22dp" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line" />

    <!-- On-screen receipt preview -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <ImageView android:layout_width="140dp" android:layout_height="wrap_content" android:layout_gravity="center" android:adjustViewBounds="true" android:src="@drawable/instacom_logo" android:contentDescription="@string/app_name" />
                <TextView android:id="@+id/rcMerchant" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/ink" android:textStyle="bold" android:textSize="15sp" android:gravity="center" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/rcBranch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/slate" android:textSize="12sp" android:gravity="center" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/rcDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/ink" android:textSize="13sp" android:fontFamily="monospace" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Powered by InstacomPay" android:textColor="@color/slate" android:textSize="10sp" android:gravity="center" android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>

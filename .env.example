# ─────────────────────────────────────────────────────────────────────────────
# Instacompay Gateway — environment template (DEP-2)
# Copy to `.env` and fill in REAL values. Never commit `.env` (see .gitignore).
# Dev and Production use FULLY SEPARATE values — no secret is reused (§2.2, DEP-8).
# All money is integer ngwee (NN-1); currency is ZMW only (NN-3).
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment marker ──
NODE_ENV=development
APP_ENV=development                 # development | production
CURRENCY=ZMW                        # NN-3 — do not change

# ── PostgreSQL (ic-postgres) — internal Docker network only (NN-5, SEC-D5) ──
# ONE shared database for all four apps (NN-4).
POSTGRES_HOST=ic-postgres
POSTGRES_PORT=5432
POSTGRES_DB=instacompay
POSTGRES_USER=instacompay
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgres://instacompay:change-me-strong-db-password@ic-postgres:5432/instacompay

# ── Per-app least-privilege DB roles (SEC-D7) ──
# Migrations and role provisioning use DATABASE_URL (owner) above. Each app then
# connects with its OWN least-privilege role. Passwords are set into the roles by
# `provision:roles` and must match the URLs below. Landing has NO database role
# by design (§6.3) — do not give it a connection string.
IC_API_DB_PASSWORD=change-me-api-db-password
IC_ADMIN_DB_PASSWORD=change-me-admin-db-password
IC_MERCHANT_DB_PASSWORD=change-me-merchant-db-password
IC_API_DATABASE_URL=postgres://ic_app_api:change-me-api-db-password@ic-postgres:5432/instacompay
IC_ADMIN_DATABASE_URL=postgres://ic_app_admin:change-me-admin-db-password@ic-postgres:5432/instacompay
IC_MERCHANT_DATABASE_URL=postgres://ic_app_merchant:change-me-merchant-db-password@ic-postgres:5432/instacompay

# ── Redis (ic-redis) — internal only, password-protected (NN-5, SEC-D6) ──
REDIS_HOST=ic-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@ic-redis:6379

# ── Auth / sessions (SEC-A1, SEC-A2, SEC-A3) ──
JWT_ACCESS_SECRET=change-me-access-secret
AUTH_ACCESS_TTL_SEC=900             # access token TTL, ≤15 min (SEC-A3)
AUTH_REFRESH_TTL_SEC=604800         # refresh token TTL, 7 days (rotating)
OTP_TTL_SECONDS=300                 # OTP lifetime, ≤5 min, single-use (SEC-A1)
AUTH_MAX_FAILED=5                   # failed logins before lockout (SEC-A5)
AUTH_LOCK_SECONDS=900               # lockout duration
# AUTH_EXPOSE_OTP=true             # DEV/TEST ONLY: return OTP in the login response
CORS_ORIGINS=                       # comma-separated portal origins; empty reflects request origin

# ── Money engine thresholds ──
DUAL_CONTROL_THRESHOLD=10000000     # ngwee (=100,000 ZMW); credits ABOVE this need a 2nd approver (FLOAT-3). Unset/0 => ALL credits require dual approval (fail safe)
IDEMPOTENCY_TTL_SECONDS=86400       # ≥24h (IDEM-3)

# ── Backups (§7.8, SEC-B1/B2/B3) ──
BACKUP_ENCRYPTION_KEY=change-me-strong-backup-key  # AES-256 passphrase; store in a password manager (SEC-B3)
BACKUP_INTERVAL_SECONDS=86400       # backup cadence (daily)
BACKUP_KEEP=14                      # local encrypted copies to retain
# Off-site copy is REQUIRED in production (SEC-B1). $BACKUP_FILE is the encrypted file:
# BACKUP_REMOTE=s3://instacompay-backups
# BACKUP_UPLOAD_CMD=aws s3 cp "$BACKUP_FILE" "$BACKUP_REMOTE/"

# ── /v1 API auth & limits (§8, SEC-API2/3/6) ──
# 32-byte key, base64, for AES-GCM encryption of per-credential HMAC signing keys.
# Generate: openssl rand -base64 32   (separate per environment, never reused)
API_SIGNING_ENC_KEY=replace-with-base64-of-32-random-bytes
API_REPLAY_WINDOW_SECONDS=300       # signed-request timestamp window (SEC-API3)
API_RATE_WINDOW_MS=60000            # rate-limit window (SEC-API6)
API_RATE_MAX=120                    # max requests per api_key+IP per window

# ── Webhooks (§5.7) ──
WEBHOOK_WORKER=on                   # background delivery worker; set 'off' to disable
WEBHOOK_POLL_MS=1000                # queue poll interval
WEBHOOK_TIMEOUT_MS=10000            # per-delivery HTTP timeout
# Retry backoff is fixed at 1m,5m,30m,2h,6h then GIVEN_UP (WH-4).

# ── SMTP — OTP + notifications (§9.3); configure SPF/DKIM/DMARC in DNS ──
# Leave SMTP_HOST empty for local dev: emails are NOT sent (use AUTH_EXPOSE_OTP=true).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587                       # 587 STARTTLS (or 465 implicit TLS)
SMTP_USER=noreply@instacompayzm.com
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@instacompayzm.com

# ── Public hostnames (§2.1) — dev values shown; prod re-points per §10.1/DNS-5 ──
LANDING_HOST=dev.instacompayzm.com
ADMIN_HOST=admin.dev.instacompayzm.com
MERCHANT_HOST=merchants.dev.instacompayzm.com
API_HOST=api.dev.instacompayzm.com

# ── Service ports (internal; proxied by Nginx, not public — §2.1, NN-5) ──
ADMIN_PORT=8010
MERCHANT_PORT=8020
API_PORT=8030
LANDING_PORT=8040

# ── Portals (browser-side, build-time NEXT_PUBLIC_*) ──
# API base the admin + merchant consoles call. Prod: https://api.instacompayzm.com
NEXT_PUBLIC_API_URL=http://localhost:8030
# Merchant portal URL the landing site links to. Prod: https://merchants.instacompayzm.com
NEXT_PUBLIC_MERCHANT_URL=http://localhost:8020

# ── Airtel Zambia Open API (processor integration) ──
# Master switch + which Airtel environment live dispatch targets (PRODUCTION | STAGING).
# Only PRODUCTION-mode merchant accounts reach Airtel; SANDBOX accounts use the simulator.
AIRTEL_ENABLED=false
AIRTEL_ENV=STAGING
AIRTEL_COUNTRY=ZM
AIRTEL_CURRENCY=ZMW
AIRTEL_BALANCE_ENABLED=false          # Balance Enquiry is 403 until Airtel enables it on our profile
AIRTEL_HTTP_TIMEOUT_MS=15000
# Production profile
AIRTEL_PROD_BASE_URL=https://openapi.airtel.co.zm
AIRTEL_PROD_CLIENT_ID=
AIRTEL_PROD_CLIENT_SECRET=
AIRTEL_PROD_PUBLIC_KEY=               # base64 DER/SPKI 1024-bit RSA key for disbursement PIN encryption
AIRTEL_PROD_DISBURSE_PIN=             # 4-digit wallet PIN (B2C); never logged
# Staging/UAT profile (openapiuat — currently unreliable)
AIRTEL_STAGING_BASE_URL=https://openapiuat.airtel.co.zm
AIRTEL_STAGING_CLIENT_ID=
AIRTEL_STAGING_CLIENT_SECRET=
AIRTEL_STAGING_PUBLIC_KEY=
AIRTEL_STAGING_DISBURSE_PIN=

# ── MTN MoMo Open API (processor integration) ──
# Per-product auth: each product has its own subscription key + API user + key.
# Only PRODUCTION-mode accounts reach MTN; SANDBOX accounts use the simulator.
MTN_ENABLED=false
MTN_ENV=PRODUCTION
MTN_TARGET_ENVIRONMENT=mtnzambia
MTN_CURRENCY=ZMW
MTN_HTTP_TIMEOUT_MS=15000
MTN_PROD_BASE_URL=https://proxy.momoapi.mtn.com
MTN_SANDBOX_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Collection product
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_COLLECTION_API_USER=
MTN_COLLECTION_API_KEY=
# Disbursement product
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_DISBURSEMENT_API_USER=
MTN_DISBURSEMENT_API_KEY=

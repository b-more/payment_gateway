<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView android:id="@+id/backBtn" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_back" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Disburse — pay out" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:layout_marginStart="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Needs approval" android:textColor="#B45309" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_badge_amber" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

        <!-- LEFT -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:orientation="vertical" android:gravity="center" android:padding="16dp" android:background="@color/surface">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAYOUT AMOUNT" android:textColor="@color/slate" android:textSize="13sp" android:letterSpacing="0.05" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K" android:textColor="#94A3B8" android:textSize="28sp" android:textStyle="bold" android:layout_marginEnd="6dp" android:paddingBottom="6dp" />
                <TextView android:id="@+id/amountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="54sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_segment" android:padding="4dp" android:layout_marginTop="16dp">
                <TextView android:id="@+id/mtnBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MTN" android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/airtelBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Airtel" android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <EditText android:id="@+id/msisdn" android:layout_width="320dp" android:layout_height="wrap_content" android:hint="260970000000" android:inputType="phone" android:autofillHints="off" android:textSize="18sp" android:gravity="center" android:layout_marginTop="12dp" />
            <EditText android:id="@+id/reason" android:layout_width="320dp" android:layout_height="wrap_content" android:hint="Reason (optional)" android:inputType="text" android:autofillHints="off" android:textSize="15sp" android:gravity="center" android:layout_marginTop="8dp" />

            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textStyle="bold" android:textSize="14sp" android:gravity="center" android:layout_marginTop="10dp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line" />

        <!-- RIGHT: keypad -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/key1" style="@style/PosKey" android:text="1" />
                <TextView android:id="@+id/key2" style="@style/PosKey" android:text="2" />
                <TextView android:id="@+id/key3" style="@style/PosKey" android:text="3" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/key4" style="@style/PosKey" android:text="4" />
                <TextView android:id="@+id/key5" style="@style/PosKey" android:text="5" />
                <TextView android:id="@+id/key6" style="@style/PosKey" android:text="6" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/key7" style="@style/PosKey" android:text="7" />
                <TextView android:id="@+id/key8" style="@style/PosKey" android:text="8" />
                <TextView android:id="@+id/key9" style="@style/PosKey" android:text="9" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/keyDot" style="@style/PosKey" android:text="." />
                <TextView android:id="@+id/key0" style="@style/PosKey" android:text="0" />
                <TextView android:id="@+id/keyDel" style="@style/PosKey" android:text="⌫" />
            </LinearLayout>
            <Button android:id="@+id/requestBtn" android:layout_width="match_parent" android:layout_height="56dp" android:text="Request payout" android:textAllCaps="false" android:textSize="17sp" android:backgroundTint="@color/ink" android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
